# ===========================================
# ローカル開発用
# ===========================================
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yamada_bt?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/yamada_bt?schema=public"

# ===========================================
# Supabase (Vercelデプロイ用)
# ===========================================
# Supabase Dashboard > Settings > Database から取得
# Transaction mode (Connection Pooler) - アプリ接続用
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session mode (Direct) - マイグレーション用
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ===========================================
# Auth.js
# ===========================================
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===========================================
# App
# ===========================================
ALLOWED_DOMAIN="example.com"

# Vercel自動設定 (手動設定不要)
# AUTH_URL は Vercel が VERCEL_URL から自動設定
